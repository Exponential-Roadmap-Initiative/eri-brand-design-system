        "min": 4.5,
        "kind": "text",
        "knownGap": {
          "measured": {
            "light": 4.39
          },
          "note": "Muted text on the muted surface, light mode. Brand values as they are on 2a7aaa9; a fix changes a brand value, so it needs Nicklas's approval."
        }
      },
      {
        "fg": "secondary-foreground",
        "bg": "secondary",
        "min": 4.5,
        "kind": "text"
      },
      {
        "fg": "accent-foreground",
        "bg": "accent",
        "min": 4.5,
        "kind": "text"
      },
      {
        "fg": "primary-foreground",
        "bg": "primary",
        "min": 4.5,
        "kind": "text",
        "knownGap": {
          "measured": {
            "light": 3.88,
            "dark": 3.88
          },
          "note": "White on ERI green (button text). Passes 3:1 for large or bold text only. A fix changes a brand value, so it needs Nicklas's approval."
        }
      },
      {
        "fg": "destructive-foreground",
        "bg": "destructive",
        "min": 4.5,
        "kind": "text"
      },
      {
        "fg": "success",
        "bg": "card",
        "min": 4.5,
        "kind": "text"
      },
