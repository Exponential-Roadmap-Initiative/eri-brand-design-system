      {
        "fg": "warning",
        "bg": "background",
        "min": 4.5,
        "kind": "text"
      },
      {
        "fg": "brand-heading",
        "bg": "brand-page-bg",
        "min": 4.5,
        "kind": "text"
      },
      {
        "fg": "ring",
        "bg": "background",
        "min": 3,
        "kind": "non-text"
      },
      {
        "fg": "ring",
        "bg": "card",
        "min": 3,
        "kind": "non-text"
      },
      {
        "fg": "input",
        "bg": "card",
        "min": 3,
        "kind": "non-text",
        "knownGap": {
          "measured": {
            "light": 1.27,
            "dark": 1.16
          },
          "note": "Text-field edge on the card. A field whose only boundary is this edge needs 3:1 (WCAG 1.4.11). A fix is a new control-edge value, for Nicklas's approval."
        }
      },
      {
        "fg": "border",
        "bg": "card",
        "min": 3,
        "kind": "non-text",
        "knownGap": {
          "measured": {
            "light": 1.27,
            "dark": 1.38
          },
          "note": "Separator lines. Decorative separators are outside WCAG 1.4.11; where a border is a control's only edge it needs 3:1. Kept here so the choice is explicit."
        }
      }
    ]
  },
